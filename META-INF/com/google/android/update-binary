#!/sbin/sh
#################
# Magisk Module installer stub. Magisk replaces the real logic at flash time
# using util_functions + customize.sh. This stub just sources it.
#################
umask 022
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
. /data/adb/magisk/util_functions.sh
install_module
exit 0
